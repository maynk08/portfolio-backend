# Runtime environment: development, test or production
NODE_ENV=development

# Port the API listens on
PORT=4000

# MongoDB connection string, including the database name
MONGODB_URI=mongodb://localhost:27017/portfolio

# Log level: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Secret used to sign admin access tokens: at least 32 characters, random.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Read only by `npm run seed:admin`, which creates the admin or resets the email and password.
# Password: at least 12 characters. Remove ADMIN_PASSWORD from .env after running the seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Media storage (AWS S3). Leave all four empty to run without uploads; set all four to enable them.
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: public base URL for uploaded files, for example a CDN in front of the bucket.
# Defaults to https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com
MEDIA_PUBLIC_BASE_URL=
